{
  "expo": {
    "name": "Gripped",
    "slug": "cruxlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cruxlog",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.cruxlog.app",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Gripped uses the camera to record beta videos of your climbing attempts.",
        "NSMicrophoneUsageDescription": "Gripped records audio alongside your beta videos so you can narrate your sequences.",
        "NSPhotoLibraryUsageDescription": "Gripped saves your beta recordings to your photo library for easy access and sharing.",
        "NSPhotoLibraryAddUsageDescription": "Gripped saves your beta recordings to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "dark": {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.cruxlog.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Gripped uses the camera to record beta videos of your climbing attempts.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Gripped records audio alongside your beta videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Gripped uses the camera to record beta videos of your climbing attempts.",
          "microphonePermission": "Gripped records audio alongside your beta videos.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/withStripPushNotifications",
      "expo-asset",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Save to Gripped",
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gripped needs access to your photos so you can attach images to your projects."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0116610b-c5ce-4b15-a456-12aa92533c94"
      }
    }
  }
}