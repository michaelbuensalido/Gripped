{
  "expo": {
    "name": "CruxLog",
    "slug": "cruxlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cruxlog",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cruxlog.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CruxLog needs camera access to detect climbing holds and human pose in real time.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.cruxlog.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "CruxLog needs camera access to detect climbing holds and human pose in real time."
        }
      ],
      "./plugins/withClimbingPoseTracker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0116610b-c5ce-4b15-a456-12aa92533c94"
      }
    }
  }
}