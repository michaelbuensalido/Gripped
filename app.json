{
  "expo": {
    "name": "CruxLog",
    "slug": "cruxlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cruxlog",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cruxlog.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.cruxlog.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "CruxLog needs camera access to detect climbing holds and human pose in real time."
        }
      ],
      "./plugins/withClimbingPoseTracker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
